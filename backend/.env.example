# NVIDIA Nemotron-3.5-Lightning-30B-A3B Configuration
# Obtain your key from NVIDIA Build: https://build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Fallback API keys (optional)
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# Database Configuration (Defaults to local SQLite fallback if PostgreSQL is not running)
# PostgreSQL via Docker Compose:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/math_web
# Or SQLite:
# DATABASE_URL=sqlite:///math_web.db

# Stripe Real-Life Payment Gateway Configuration
# Obtain your keys from the Stripe Dashboard: https://dashboard.stripe.com/apikeys
# Supports both test mode (sk_test_..., pk_test_...) and production live mode (sk_live_..., pk_live_...)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Stripe Webhook Secret from https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=
# Frontend domain origin for checkout redirects (defaults to http://localhost:5173 in development)
FRONTEND_URL=http://localhost:5173


